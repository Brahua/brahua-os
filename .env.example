# Environment variable names only. Never commit real values.

# Neon pooled connection (-pooler host). Used by the app at runtime.
DATABASE_URL=
# Neon direct connection. Used by `pnpm db:migrate` and `pnpm db:seed`.
DATABASE_URL_UNPOOLED=

# Throwaway Postgres 18 for `pnpm test:integration` and `pnpm test:e2e` (`pnpm db:test:start`).
# Local default when unset: postgres://postgres:postgres@localhost:54329/brahua_os_test
TEST_DATABASE_URL=

# Better Auth (SPEC-core). Required at runtime; the production build fails without them.
# Random, at least 32 characters, different per environment: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public origin of the app. Production: https://os.brahua.com · local: http://localhost:3000
BETTER_AUTH_URL=
# The only account allowed to sign in. Created with `pnpm auth:owner`.
OWNER_EMAIL=

# reminders (SPEC-reminders). Optional until the owner sets them (Ajustes → Avisos says what is missing).
# Telegram bot: token from @BotFather, a random webhook secret (16+ chars of A-Z a-z 0-9 _ -:
# `openssl rand -hex 24`), and the bot's @username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# Secret of POST /api/reminders/tick (16+ chars). GitHub Actions sends REMINDERS_CRON_SECRET; Vercel
# Cron sends CRON_SECRET: set both to the same value.
REMINDERS_CRON_SECRET=
CRON_SECRET=
# Tests only: base URL of a fake Telegram server (the official https://api.telegram.org when unset).
TELEGRAM_API_BASE=
# Push web (SPEC-reminders, R5). Generate the pair with `pnpm reminders:vapid` in YOUR terminal and
# copy the values straight into Vercel and the repo secrets; never paste them anywhere else.
# VAPID_SUBJECT is `mailto:you@example.com` or an https URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
