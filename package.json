{
  "name": "brahua-os",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:changed": "playwright test --only-changed=origin/main",
    "design:theme": "node scripts/build-tailwind-theme.mjs",
    "design:lock": "node scripts/design-lock.mjs",
    "design:check": "node scripts/design-lock.mjs --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/check-db-target.ts && drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:export": "tsx scripts/db-export.ts",
    "db:test:start": "tsx scripts/test-db.ts start",
    "db:test:stop": "tsx scripts/test-db.ts stop",
    "db:test:reset": "tsx scripts/test-db.ts reset",
    "auth:owner": "tsx scripts/auth-owner.ts",
    "auth:check-env": "tsx scripts/check-auth-env.ts",
    "icons:build": "tsx scripts/build-icons.tsx",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.6",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@simplewebauthn/browser": "13.3.0",
    "@vercel/functions": "^3.9.9",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  }
}
